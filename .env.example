# Zotero API Configuration
# Get your credentials from: https://www.zotero.org/settings/keys

# Your Zotero User ID (find it in the Feeds/API section at the link above)
VITE_ZOTERO_USER_ID=your_user_id_here

# Your Zotero API Key (create a new key with "Allow library access" permission)
VITE_ZOTERO_API_KEY=your_api_key_here

# IMPORTANT: Never commit your actual .env file to git!
# This .env.example file is just a template.
