# Zotero OAuth Configuration
# Register your app at: https://www.zotero.org/oauth/apps

# OAuth Client Key (provided when you register your app)
ZOTERO_CLIENT_KEY=your_client_key_here

# OAuth Client Secret (provided when you register your app)
ZOTERO_CLIENT_SECRET=your_client_secret_here

# IMPORTANT: Never commit your actual .env file to git!
# This .env.example file is just a template.
#
# The client key and secret are used server-side in Netlify Functions
# to handle OAuth authentication securely.
